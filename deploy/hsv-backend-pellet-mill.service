[Unit]
Description=HSV Safety Vision - Backend Pellet Mill (FastAPI + Gemini snapshot scan)
After=network.target docker.service hsv-backend.service
Requires=docker.service

[Service]
Type=simple
User=orin_nano
WorkingDirectory=/home/orin_nano/Smart-HSV-FeedmillTarlac
ExecStartPre=/usr/bin/docker compose up -d
ExecStart=/home/orin_nano/.local/bin/uv run python main.py --site pellet_mill --port 8001
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/orin_nano/Smart-HSV-FeedmillTarlac/logs/service-pellet-mill.log
StandardError=append:/home/orin_nano/Smart-HSV-FeedmillTarlac/logs/service-pellet-mill-error.log

[Install]
WantedBy=multi-user.target
